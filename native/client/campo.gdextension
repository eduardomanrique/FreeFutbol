[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
macos.debug = "res://bin/libcampo_godot.dylib"
macos.release = "res://bin/libcampo_godot.dylib"
linux.debug.x86_64 = "res://bin/libcampo_godot.so"
linux.release.x86_64 = "res://bin/libcampo_godot.so"
linux.debug.arm64 = "res://bin/libcampo_godot.so"
linux.release.arm64 = "res://bin/libcampo_godot.so"
windows.debug.x86_64 = "res://bin/campo_godot.dll"
windows.release.x86_64 = "res://bin/campo_godot.dll"
